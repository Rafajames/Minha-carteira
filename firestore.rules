rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMember() { return signedIn() && request.auth.uid in resource.data.members; }
    function memberOf(fid) { return signedIn() && request.auth.uid in get(/databases/$(database)/documents/families/$(fid)).data.members; }
    // Administrador: e-mail confirmado e na lista abaixo
    function isAdm() { return signedIn() && request.auth.token.email_verified == true
      && request.auth.token.email.lower() in ['EMAIL_DO_ADMIN']; }
    function suporteAtivo() { return isAdm() && resource.data.get('supportUntil', null) != null && resource.data.supportUntil > request.time; }

    // Cada pessoa só lê e altera o próprio perfil (família e lançamentos privados)
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /families/{familyId} {
      // Criar família: quem cria vira dono e único membro
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid];

      // Ler: só membros
      allow read: if isMember();

      // Alterar dados: membros. Só o dono remove outras pessoas; cada um pode sair sozinho
      allow update: if isMember()
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.members.hasAll([resource.data.owner])
        && ( request.resource.data.members.hasAll(resource.data.members)
             || request.auth.uid == resource.data.owner
             || request.resource.data.members == resource.data.members.removeAll([request.auth.uid]) );

      // Entrar pelo convite: precisa do código atual do link (gerar um link novo desativa o anterior)
      allow update: if signedIn()
        && !(request.auth.uid in resource.data.members)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'joinCode'])
        && request.resource.data.members == resource.data.members.concat([request.auth.uid])
        && request.resource.data.joinCode == resource.data.invite
        && resource.data.members.size() < 6;

      // Suporte: o administrador lê e corrige a família só enquanto ela liberar um código (24 horas)
      allow read: if suporteAtivo();
      allow update: if suporteAtivo()
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.members == resource.data.members
        && request.resource.data.supportUntil == resource.data.supportUntil;

      // Excluir: só o dono
      allow delete: if signedIn() && request.auth.uid == resource.data.owner;

      // Cópias de segurança: só membros da família
      match /backups/{backupId} {
        allow read, write: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.members;
      }
    }

    // Uso do app, sem valores: cada família e cada pessoa registram o próprio; só o administrador lê
    match /stats/{familyId} {
      allow write: if memberOf(familyId);
      allow read: if isAdm();
    }
    match /profiles/{uid} {
      allow write: if signedIn() && request.auth.uid == uid;
      allow read: if isAdm();
    }

    // Códigos de suporte: um membro cria para a própria família; o administrador lê
    match /support/{code} {
      allow create: if signedIn() && request.resource.data.by == request.auth.uid && memberOf(request.resource.data.famId);
      allow read: if isAdm() || (signedIn() && resource.data.by == request.auth.uid);
      allow delete: if isAdm() || memberOf(resource.data.famId);
    }

    // Padrões do app (palavras e categorias): todos leem, só o administrador altera
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdm();
    }
  }
}
